# ImageKit.io Configuration
# 1. URL-endpoint (Found in ImageKit Dashboard -> Developer Options)
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/fm5abuzok

# 2. (Optional) Private API Key for automatic gallery sync
# If provided, all uploaded photos in your ImageKit account are automatically fetched and shown!
# Found in ImageKit Dashboard -> Developer Options -> API Keys -> Private Key
IMAGEKIT_PRIVATE_KEY=your_private_key_here
