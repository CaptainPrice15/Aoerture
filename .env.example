# ImageKit.io Configuration
# 1. URL-endpoint (Found in ImageKit Dashboard -> Developer Options)
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/fm5abuzok

# 2. (Optional) Private API Key for automatic gallery sync (server-side only)
# If provided, all uploaded photos in your ImageKit account are automatically fetched and shown!
# Found in ImageKit Dashboard -> Developer Options -> API Keys -> Private Key
IMAGEKIT_PRIVATE_KEY=your_private_key_here

# Server-side administrator login. Generate SESSION_SECRET with a secure random
# value of at least 32 characters (for example: openssl rand -base64 48).
ADMIN_PASSWORD=replace_with_a_strong_unique_password
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Never put ImageKit private keys, admin passwords, or other secrets in VITE_
# variables. VITE_ values are included in the browser bundle.

